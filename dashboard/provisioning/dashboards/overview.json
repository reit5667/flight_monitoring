          "format": "table",
          "rawSql": "SELECT\n  fc.price::float AS price,\n  r.origin || ' → ' || r.destination AS route,\n  fc.airline,\n  fc.flight_number,\n  fc.departure_time,\n  fc.source\nFROM flights_current fc\nJOIN routes r ON r.route_id = fc.route_id\nORDER BY fc.price ASC\nLIMIT 5",
